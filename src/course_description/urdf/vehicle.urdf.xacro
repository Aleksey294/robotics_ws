<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="course_ackermann">
  <xacro:arg name="wheelbase" default="0.8"/>
  <xacro:arg name="track" default="0.62"/>
  <xacro:arg name="wheel_radius" default="0.12"/>
  <xacro:property name="wheelbase" value="${float('$(arg wheelbase)')}"/>
  <xacro:property name="track" value="${float('$(arg track)')}"/>
  <xacro:property name="wheel_radius" value="${float('$(arg wheel_radius)')}"/>
  <xacro:property name="wheel_width" value="0.07"/>
  <xacro:property name="wheel_mass" value="0.8"/>
  <xacro:property name="body_length" value="1.05"/>
  <xacro:property name="body_width" value="0.52"/>
  <xacro:property name="body_height" value="0.22"/>
  <xacro:property name="sensor_x" value="0.28"/>
  <xacro:property name="sensor_z" value="0.38"/>

  <material name="body_blue"><color rgba="0.05 0.36 0.72 1"/></material>
  <material name="rubber"><color rgba="0.06 0.06 0.07 1"/></material>
  <material name="metal"><color rgba="0.55 0.58 0.62 1"/></material>
  <material name="camera_green"><color rgba="0.15 0.8 0.35 1"/></material>
  <material name="lidar_orange"><color rgba="1 0.5 0.08 1"/></material>
  <material name="imu_purple"><color rgba="0.75 0.3 0.85 1"/></material>

  <xacro:macro name="box_link" params="name x y z mass xyz color">
    <link name="${name}">
      <visual>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
        <material name="${color}"/>
      </visual>
      <collision>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${xyz}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass*(y*y+z*z)/12}" iyy="${mass*(x*x+z*z)/12}"
                 izz="${mass*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel" params="name parent xyz">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"
                 iyy="${wheel_mass*wheel_radius*wheel_radius/2}"
                 izz="${wheel_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="${parent}"/><child link="${name}"/>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10" velocity="20"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="front_corner" params="side sign">
    <xacro:box_link name="front_${side}_knuckle" x="${wheel_width/2}"
                    y="${wheel_width/2}" z="${wheel_width/2}" mass="0.2"
                    xyz="0 0 0" color="metal"/>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/><child link="front_${side}_knuckle"/>
      <origin xyz="${wheelbase/2} ${sign*track/2} 0" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.55" upper="0.55" effort="25" velocity="1"/>
    </joint>
    <xacro:wheel name="front_${side}_wheel" parent="front_${side}_knuckle" xyz="0 0 0"/>
  </xacro:macro>

  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>
  <xacro:box_link name="base_link" x="${body_length}" y="${body_width}"
                  z="${body_height}" mass="12" xyz="0 0 0.12" color="body_blue"/>
  <xacro:front_corner side="left" sign="1"/>
  <xacro:front_corner side="right" sign="-1"/>
  <xacro:wheel name="rear_left_wheel" parent="base_link" xyz="${-wheelbase/2} ${track/2} 0"/>
  <xacro:wheel name="rear_right_wheel" parent="base_link" xyz="${-wheelbase/2} ${-track/2} 0"/>

  <xacro:box_link name="camera_link" x="0.08" y="0.06" z="0.04"
                  mass="0.033333333333" xyz="0.04 0 0" color="camera_green"/>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/><child link="camera_optical_frame"/>
    <origin xyz="0.08 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
      <material name="lidar_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.04"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.033333333333"/>
      <inertia ixx="${0.033333333333*(3*0.035**2+0.04**2)/12}"
               iyy="${0.033333333333*(3*0.035**2+0.04**2)/12}"
               izz="${0.033333333333*0.035**2/2}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>
  <xacro:box_link name="imu_link" x="0.04" y="0.03" z="0.015"
                  mass="0.033333333334" xyz="-0.05 0 0" color="imu_purple"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="${sensor_x} 0 ${sensor_z}" rpy="0 0 0"/>
  </joint>
</robot>
